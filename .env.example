# ================================
# n8n e afins — ambiente APOD
# ================================
# Copie para .env ou use scripts/generate-env.*

# PostgreSQL
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=GENERATE_ME
POSTGRES_USER=n8n
POSTGRES_PASSWORD=GENERATE_ME
POSTGRES_DB=n8n

# Redis
REDIS_PASSWORD=GENERATE_ME

# n8n
N8N_ENCRYPTION_KEY=GENERATE_ME
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=America/Sao_Paulo

# Segredo opcional para validar webhooks recebidos
TELEGRAM_WEBHOOK_SECRET=GENERATE_ME

# NASA — obtido externamente em api.nasa.gov
NASA_API_KEY=

# Telegram — BOT token vem do BotFather
TELEGRAM_BOT_TOKEN=
# Estes dois podem ser descobertos com scripts/discover-telegram-ids.*
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USER_ID=

# Instagram/Meta — serão usados na próxima etapa
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
